<!DOCTYPE html>
<html lang="az">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sun Kazino</title>
    <script src="https://telegram.org/js/telegram-web-app.js"></script>
    <style>
        body {
            background-color: #0d0f12;
            color: #ffffff;
            font-family: sans-serif;
            text-align: center;
            margin: 0;
            padding: 20px;
        }
        .header {
            color: #ffd700;
            font-size: 26px;
            font-weight: bold;
            margin-bottom: 5px;
        }
        .subtext {
            color: #aaa;
            font-size: 14px;
            margin-bottom: 20px;
        }
        .balance-card {
            background: rgba(255, 215, 0, 0.1);
            border: 1px solid #ffd700;
            border-radius: 12px;
            padding: 10px 20px;
            display: inline-block;
            margin-bottom: 25px;
            font-size: 18px;
            font-weight: bold;
            color: #ffd700;
        }
        .slot-machine {
            background: #1a1d24;
            border: 3px solid #ffd700;
            border-radius: 20px;
            padding: 20px;
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-bottom: 30px;
        }
        .slot {
            width: 70px;
            height: 90px;
            background: #0d0f12;
            border: 2px solid #333;
            border-radius: 10px;
            font-size: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-spin {
            background: linear-gradient(135deg, #ffd700, #ff8c00);
            color: #000;
            border: none;
            padding: 18px 40px;
            font-size: 18px;
            font-weight: bold;
            border-radius: 50px;
            cursor: pointer;
        }
        .result {
            margin-top: 20px;
            font-size: 18px;
            font-weight: bold;
            height: 24px;
        }
    </style>
</head>
<body>

    <div class="header">☀️ SUN KAZİNO ☀️</div>
    <div class="subtext">Oyna və Qazan!</div>

    <div class="balance-card">
        Balans: <span id="balance">1000</span> COINS
    </div>

    <div class="slot-machine">
        <div class="slot" id="slot1">☀️</div>
        <div class="slot" id="slot2">☀️</div>
        <div class="slot" id="slot3">☀️</div>
    </div>

    <button class="btn-spin" onclick="spin()">OYNA (50 COINS)</button>

    <div class="result" id="result"></div>

    <script>
        const tg = window.Telegram.WebApp;
        tg.expand();

        let balance = 1000;
        const symbols = ['☀️', '🔔', '⭐', '7️⃣', '👑'];

        function spin() {
            if (balance < 50) {
                document.getElementById('result').innerText = "❌ Balansınız çatmır!";
                document.getElementById('result').style.color = "#ff4d4d";
                return;
            }

            balance -= 50;
            document.getElementById('balance').innerText = balance;

            let slot1 = symbols[Math.floor(Math.random() * symbols.length)];
            let slot2 = symbols[Math.floor(Math.random() * symbols.length)];
            let slot3 = symbols[Math.floor(Math.random() * symbols.length)];

            document.getElementById('slot1').innerText = slot1;
            document.getElementById('slot2').innerText = slot2;
            document.getElementById('slot3').innerText = slot3;

            if (slot1 === slot2 && slot2 === slot3) {
                let winAmount = slot1 === '☀️' ? 500 : 300;
                balance += winAmount;
                document.getElementById('balance').innerText = balance;
                document.getElementById('result').innerText = `🎉 UDUŞ! +${winAmount} COINS!`;
                document.getElementById('result').style.color = "#4dff88";
            } else if (slot1 === slot2 || slot2 === slot3 || slot1 === slot3) {
                balance += 70;
                document.getElementById('balance').innerText = balance;
                document.getElementById('result').innerText = "✨ Kiçik Uduş! +70 COINS!";
                document.getElementById('result').style.color = "#ffd700";
            } else {
                document.getElementById('result').innerText = "Uduzduz, yenidən cəhd edin!";
                document.getElementById('result').style.color = "#aaa";
            }
        }
    </script>
</body>
</html>
